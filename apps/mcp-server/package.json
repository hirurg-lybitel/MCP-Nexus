{
  "name": "@mcp-nexus/mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Gedemin accounting (v2): stdio and Streamable HTTP",
  "scripts": {
    "dev": "tsx watch src/index.ts http",
    "dev:stdio": "tsx src/index.ts stdio",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts http",
    "start:stdio": "tsx src/index.ts stdio",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@mcp-nexus/db-firebird": "workspace:*",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
