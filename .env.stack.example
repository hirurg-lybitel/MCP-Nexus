# Stack on WORKING: docker compose -f docker-compose.stack.yaml --env-file .env up -d --build
NODE_ENV=production
PORT=4004
MCP_PORT=4005
NEXT_PUBLIC_MCP_PORT=4005
MCP_HOST=0.0.0.0
MCP_API_KEY=replace-with-long-secret

# Firebird on another LAN host (not in Docker)
NODE_FB_HOST=192.168.0.62
NODE_FB_PORT=3056
NODE_FB_DB=k:/Bases/Broiler/GDBASE_2026_02_05.FDB
ISC_USER=SYSDBA
ISC_PASSWORD=masterkey
FIREBIRD_SQL_DIALECT=3
FIREBIRD_MIN_ENGINE_MAJOR=5

# Gedemin on this Windows host (outside Docker)
GEDEMIN_WORKER_URL=http://host.docker.internal:9080
GEDEMIN_WORKER_USER=mcp_worker
GEDEMIN_WORKER_PASSWORD=replace-me
GEDEMIN_WORKER_TOKEN=mcp-worker-dev

# Web BFF -> mcp-server (compose also sets this)
MCP_UPSTREAM_URL=http://mcp-server:4005/mcp
WEB_EMBEDDED_MCP=0